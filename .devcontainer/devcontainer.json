{
    "name": "mission-bolt",
    "build": { "dockerfile": "Dockerfile" },

    "privileged": true,
    "mounts": [
        "source=/dev/bus/usb,target=/dev/bus/usb,type=bind",
        "source=mission-bolt-cmsis-packs,target=/opt/cmsis-packs,type=volume",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind"
    ],

    "containerEnv": {
        // Host path of the workspace - post-create derives the Claude
        // Code project slug from it (works for every team member's path).
        "HOST_PROJECT_DIR": "${localWorkspaceFolder}"
    },

    "postCreateCommand": "bash .devcontainer/post-create.sh",

    "customizations": {
        "vscode": {
            "extensions": [
                "marus25.cortex-debug",
                "llvm-vs-code-extensions.vscode-clangd",
                "Arm.cmsis-csolution",
                "usernamehw.errorlens",
                "PKief.material-icon-theme",
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "xaver.clang-format",
                "dbaeumer.vscode-eslint",
                "mcu-debug.memory-view",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-python.vscode-python-envs",
                "DavidAnson.vscode-markdownlint",
                "ms-vscode.vscode-serial-monitor",
                "bradlc.vscode-tailwindcss",
                "Arm.vscode-cmsis-debugger",
                "Arm.keil-studio-pack"
            ],
            "settings": {
                "clangd.arguments": [
                    "--compile-commands-dir=${workspaceFolder}/flight-software/tmp"
                ]
            }
        }
    },

    "remoteUser": "vscode"
}
