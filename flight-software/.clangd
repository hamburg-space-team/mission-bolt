CompileFlags:
  Add:
    - -std=gnu++2b
    - -xc++
    - -I../interfaces/include
    - -Ishared/bus
    - -Ishared/led
    - -Ishared/comms
    - -Ishared/core
    - -Ishared/sensors
    - -Ishared/storage
    - -Ishared/timing
    - -Ishared/utils
  Remove:
    - -masm-syntax-unified # ARM GCC-only flag, not recognized by clangd/clang
    - -masm=* # same family
    - --specs=* # linker flag leaking into compile commands
    - -fstack-usage # GCC-only codegen flag
    - -std=* # replaced by Add above
---
# Suppress diagnostics in CubeMX-generated, CMSIS RTE, host build, and
# CMake-fetched dependency folders. clangd descends into these by default
# and they emit noise we never want to fix (vendor code, broken .clang-tidy
# in third-party deps, ARM-only flags clang can't parse, etc.).
If:
  PathMatch:
    - ".*generated/.*"
    - ".*RTE/.*"
    - ".*/build/.*"
    - ".*/_deps/.*"
    - ".*/tmp/.*"
    - ".*/out/.*"
Diagnostics:
  Suppress:
    - "*"
---
# Co-located unit tests (*.test.cpp) compile in the host test build, not
# the flight contexts: read flags from the host DB and drop the tidy
# checks that misfire on Catch2's macro-generated code (these lived in
# tests/.clang-tidy before the tests moved next to their units)
If:
  PathMatch:
    - '.*\.test\.cpp'
CompileFlags:
  CompilationDatabase: build/tests
Diagnostics:
  ClangTidy:
    Remove:
      - misc-use-anonymous-namespace
      - readability-function-cognitive-complexity
      - bugprone-chained-comparison
      - cert-err58-cpp
