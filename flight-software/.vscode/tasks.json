            "command": "${env:OPENOCD} -f interface/stlink.cfg -f target/stm32h7x.cfg -c \"program ${workspaceFolder}/out/exp2-bouncy-castle/exp2/Debug/exp2.elf verify reset exit\"",
            "dependsOn": "Build exp2.Debug",
            "presentation": {
                "reveal": "always",
