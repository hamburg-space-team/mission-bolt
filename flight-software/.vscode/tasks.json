        {
            "label": "Flash btc",
            "type": "shell",
            "command": "${env:OPENOCD} -f interface/stlink.cfg -f target/stm32h7x.cfg -c \"program ${workspaceFolder}/out/btc/btc/Debug/btc.elf verify reset exit\"",
