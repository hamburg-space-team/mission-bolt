        {
            "label": "Flash test",
            "type": "shell",
            "command": "${env:OPENOCD} -f interface/stlink.cfg -f target/stm32h7x.cfg -c \"program ${workspaceFolder}/out/test/test-nucleo-h753zi/Debug/test.elf verify reset exit\"",
            "dependsOn": "Build test.Debug",
            "presentation": {
                "reveal": "always",
