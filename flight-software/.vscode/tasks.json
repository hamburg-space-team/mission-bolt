                        "-c"
                    ]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Flash exp1",
            "type": "shell",
            "command": "${env:OPENOCD} -f interface/stlink.cfg -f target/stm32h7x.cfg -c \"program ${workspaceFolder}/out/exp1-space-disco/exp1/Debug/exp1.elf verify reset exit\"",
            "dependsOn": "Build exp1.Debug",
            "presentation": {
                "reveal": "always",
