# CMSIS-Toolbox build artifacts
out/
tmp/

# CMake host build (for tests)
build/

# Merged compile_commands.json - generated by "Merge compile_commands.json" task
/compile_commands.json

# Generated by csolution convert - recreated on every cbuild
bolt.cbuild-idx.yml
bolt.cbuild-pack.yml
*.cbuild-run.yml
*.cbuild.yml

# CMSIS RTE folders - regenerated from DFP pack by csolution convert
**/RTE/

# CubeMX Eclipse/STM32CubeIDE project files
**/cubemx/.cproject
**/cubemx/.project
**/cubemx/.settings/
**/cubemx/.mxproject
**/generated/STM32CubeMX/STM32CubeIDE/.cproject
**/generated/STM32CubeMX/STM32CubeIDE/.project
**/generated/STM32CubeMX/STM32CubeIDE/.settings/

# Generated by cbridge before each CubeMX invocation - contains absolute path of current machine
**/generated/project.script

# CMSIS debug config base templates - generated from DFP pack
.cmsis/*.base@*

.cache/
*/.cache/

/.vscode/cmsis.json